<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:padding="14dp">

  <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/header_left" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_muted" android:textAlignment="viewStart" android:text="20 Rabiʻ II 1448 AH" android:maxLines="1" android:ellipsize="end"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/next_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_gold" android:textAlignment="viewStart" android:text="Next prayer" />
    <TextView android:id="@+id/next_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textColor="@color/widget_text" android:textAlignment="viewStart" android:text="Maghrib" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/next_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/widget_text" android:textAlignment="viewStart" android:text="6:32 PM" />
    <Chronometer android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:countDown="true" android:textSize="13sp" android:textColor="@color/widget_gold" android:textStyle="bold" />
    <TextView android:id="@+id/next_iqamah" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_muted" android:textAlignment="viewStart" android:text="Iqamah 6:37 PM" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>

  <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="13sp" android:textColor="@color/widget_muted" android:visibility="gone" />
</FrameLayout>
