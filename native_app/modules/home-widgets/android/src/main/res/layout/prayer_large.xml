<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:padding="14dp">

  <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/header_left" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="AMSSA" />
      <TextView android:id="@+id/header_right" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="11sp" android:textColor="@color/widget_muted" android:maxLines="1" android:ellipsize="end" android:text="20 Rabiʻ II 1448 AH" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="bottom">
      <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/next_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_gold" android:text="Next prayer" />
        <TextView android:id="@+id/next_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="Maghrib" />
      </LinearLayout>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/next_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/widget_text" android:text="6:32 PM" />
        <Chronometer android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:countDown="true" android:textSize="14sp" android:textColor="@color/widget_gold" android:textStyle="bold" />
        <TextView android:id="@+id/next_iqamah" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_muted" android:text="Iqamah 6:37 PM" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
      <FrameLayout android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="1dp" />
      <TextView android:id="@+id/col_adhan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="10sp" android:textColor="@color/widget_muted" android:text="Adhan" />
      <TextView android:id="@+id/col_iqamah" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="10sp" android:textColor="@color/widget_muted" android:text="Iqamah" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r0_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp">
      <TextView android:id="@+id/r0_name" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="Fajr" />
      <TextView android:id="@+id/r0_adhan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="4:22 AM" />
      <TextView android:id="@+id/r0_iqamah" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="4:52 AM" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r1_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp">
      <TextView android:id="@+id/r1_name" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="Sunrise" />
      <TextView android:id="@+id/r1_adhan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="5:54 AM" />
      <TextView android:id="@+id/r1_iqamah" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r2_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp">
      <TextView android:id="@+id/r2_name" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="Dhuhr" />
      <TextView android:id="@+id/r2_adhan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="12:14 PM" />
      <TextView android:id="@+id/r2_iqamah" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="12:29 PM" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r3_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp">
      <TextView android:id="@+id/r3_name" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="Asr" />
      <TextView android:id="@+id/r3_adhan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="3:44 PM" />
      <TextView android:id="@+id/r3_iqamah" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="3:59 PM" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r4_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp">
      <TextView android:id="@+id/r4_name" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="Maghrib" />
      <TextView android:id="@+id/r4_adhan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="6:30 PM" />
      <TextView android:id="@+id/r4_iqamah" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="6:35 PM" />
    </LinearLayout>
    <LinearLayout android:id="@+id/r5_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="5dp" android:paddingBottom="5dp">
      <TextView android:id="@+id/r5_name" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="Isha" />
      <TextView android:id="@+id/r5_adhan" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="7:40 PM" />
      <TextView android:id="@+id/r5_iqamah" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" android:text="7:45 PM" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_muted" android:textAlignment="viewStart" android:text="Jumu'ah: 1:30PM" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>

  <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textSize="13sp" android:textColor="@color/widget_muted" android:visibility="gone" />
</FrameLayout>
