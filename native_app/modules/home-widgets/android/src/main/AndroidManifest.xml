<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />

  <application>
    <receiver
      android:name="expo.modules.homewidgets.PrayerWidget"
      android:exported="false"
      android:label="@string/prayer_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="expo.modules.homewidgets.REFRESH" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/prayer_widget_info" />
    </receiver>

    <receiver
      android:name="expo.modules.homewidgets.HadithWidget"
      android:exported="false"
      android:label="@string/hadith_widget_name">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="expo.modules.homewidgets.REFRESH" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/hadith_widget_info" />
    </receiver>
  </application>
</manifest>
