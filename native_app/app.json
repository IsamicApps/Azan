{
  "expo": {
    "name": "Daily Hadith",
    "slug": "daily-hadith",
    "scheme": "dailyhadith",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07090f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dailyhadith.app",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.dailyhadith.app"]
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to find the closest mosque and the Qibla direction.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dailyhadith.app",
      "adaptiveIcon": {
        "backgroundColor": "#07090f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_FINE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#07090f"
        }
      ]
    ]
  }
}
